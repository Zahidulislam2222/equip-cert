# =======================================
# EquipCert AI — Environment Variables
# Copy this file to .env.local and fill in your values
# =======================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Contentful CMS ---
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your-contentful-space-id
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your-contentful-access-token

# --- AI Provider (swap anytime — zero code changes) ---
# Options: google | openai | anthropic
AI_PROVIDER=google
# Model name for the chosen provider
# Google: gemini-2.5-flash, gemini-2.5-pro
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
AI_MODEL_NAME=gemini-2.5-flash
# API key for the chosen provider
AI_API_KEY=your-ai-api-key
# Max output tokens requested from the provider
AI_MAX_TOKENS=1024
# Anthropic REST details (only used when AI_PROVIDER=anthropic)
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
AI_ANTHROPIC_VERSION=2023-06-01

# --- /api/analyze operational limits ---
# Requests allowed per AUTHENTICATED USER per window. Keying on the account rather than the
# address is deliberate: a company behind one NAT gateway would otherwise share a single
# budget between every technician, while an attacker rotating addresses gets a fresh one.
ANALYZE_RATE_LIMIT=20
# Pre-authentication guard, expressed as a multiple of the per-user limit. It only has to keep
# an unauthenticated flood off the token-verification round trip.
ANALYZE_IP_BURST_FACTOR=10
# Rate-limit window in milliseconds (default 1 hour)
ANALYZE_RATE_WINDOW_MS=3600000
# Max base64 image payload accepted, in bytes (default 10MB)
ANALYZE_MAX_IMAGE_BYTES=10485760

# --- /api/dsar (data subject request intake) operational limits ---
# Filings allowed per IP per window. Unauthenticated by design — a subject exercising erasure
# usually no longer has an account — so this is much tighter than the analyze budget.
DSAR_RATE_LIMIT=5
DSAR_RATE_WINDOW_MS=3600000

# --- Stripe (Payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App Config ---
NEXT_PUBLIC_APP_NAME=EquipCert AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Password safety ---
# Supabase's own leaked-password protection is a Pro-plan feature, so the same check runs
# client-side against the same corpus using the free k-anonymity range API. Only the first
# five characters of the password's SHA-1 are ever sent.
NEXT_PUBLIC_PWNED_RANGE_URL=https://api.pwnedpasswords.com/range
# Must stay in step with minimum_password_length in supabase/config.toml, which is the
# actual enforcer. This value only decides what the form says first.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12
# A breach-list outage must not become a signup outage, so the lookup gives up quickly and
# the length rule still applies.
NEXT_PUBLIC_PWNED_TIMEOUT_MS=4000

# --- Evidence storage ---
# The evidence bucket is PRIVATE, so every view is served through a signed URL. This is how
# long one stays valid. Long enough for a page view and a PDF render, short enough that a
# leaked link stops working.
NEXT_PUBLIC_EVIDENCE_URL_TTL_SECONDS=600

# --- Photo capture (client-side downscale before upload) ---
# Longest edge in pixels after downscale. A phone frame is 4000px+; 1600 keeps the
# request well inside ANALYZE_MAX_IMAGE_BYTES without losing inspection detail.
NEXT_PUBLIC_CAPTURE_MAX_EDGE_PX=1600
# JPEG quality as a whole-number percentage (1-100).
NEXT_PUBLIC_CAPTURE_JPEG_QUALITY=85

# --- Geolocation ---
# Reverse-geocoding endpoint used to turn GPS coords into an address
NEXT_PUBLIC_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# Browser geolocation timeout in milliseconds
NEXT_PUBLIC_GPS_TIMEOUT_MS=10000

# --- Self-hosted runtime (deploy/server.ts on the shared VPS) ---
# Ignored on Vercel, which supplies its own runtime and static file serving.
# Port the Node adapter listens on INSIDE the container.
SELF_HOST_PORT=8080
# Directory holding the Next.js static export, relative to the process cwd.
SELF_HOST_STATIC_DIR=out
# Max bytes accepted for a single request body (default 12MB, above ANALYZE_MAX_IMAGE_BYTES).
SELF_HOST_MAX_REQUEST_BYTES=12582912

# ---------------------------------------------------------------------------
# Capacity tier
#
# Every value is a REAL published limit of the named plan, not an aspiration.
# Changing tier is one variable — see docs/SCALING.md for the measured baseline,
# the binding constraint at each step, and what each step costs.
#
#   free  200 pooler / 60 direct / 200 realtime peak / 500 MB db / 5 GB egress
#   pro   500 pooler / 500 realtime peak / 8 GB db     ($25/mo, NOT enabled here)
#   team  1000 pooler                                  ($599/mo, NOT enabled here)
# ---------------------------------------------------------------------------
SUPABASE_TIER=free
SCALE_POOLER_CONNECTIONS=200
SCALE_DIRECT_CONNECTIONS=60
SCALE_REALTIME_PEAK=200
SCALE_EDGE_CACHE_SECONDS=31536000
SCALE_HTML_CACHE_SECONDS=60
