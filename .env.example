# =======================================
# EquipCert AI — Environment Variables
# Copy this file to .env.local and fill in your values
# =======================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Contentful CMS ---
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your-contentful-space-id
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your-contentful-access-token

# --- AI Provider (swap anytime — zero code changes) ---
# Options: google | openai | anthropic
AI_PROVIDER=google
# Model name for the chosen provider
# Google: gemini-2.5-flash, gemini-2.5-pro
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
AI_MODEL_NAME=gemini-2.5-flash
# API key for the chosen provider
AI_API_KEY=your-ai-api-key
# Max output tokens requested from the provider
AI_MAX_TOKENS=1024
# Anthropic REST details (only used when AI_PROVIDER=anthropic)
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
AI_ANTHROPIC_VERSION=2023-06-01

# --- /api/analyze operational limits ---
# Requests allowed per IP per window
ANALYZE_RATE_LIMIT=20
# Rate-limit window in milliseconds (default 1 hour)
ANALYZE_RATE_WINDOW_MS=3600000
# Max base64 image payload accepted, in bytes (default 10MB)
ANALYZE_MAX_IMAGE_BYTES=10485760

# --- Stripe (Payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App Config ---
NEXT_PUBLIC_APP_NAME=EquipCert AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Geolocation ---
# Reverse-geocoding endpoint used to turn GPS coords into an address
NEXT_PUBLIC_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# Browser geolocation timeout in milliseconds
NEXT_PUBLIC_GPS_TIMEOUT_MS=10000

# --- Self-hosted runtime (deploy/server.ts on the shared VPS) ---
# Ignored on Vercel, which supplies its own runtime and static file serving.
# Port the Node adapter listens on INSIDE the container.
SELF_HOST_PORT=8080
# Directory holding the Next.js static export, relative to the process cwd.
SELF_HOST_STATIC_DIR=out
# Max bytes accepted for a single request body (default 12MB, above ANALYZE_MAX_IMAGE_BYTES).
SELF_HOST_MAX_REQUEST_BYTES=12582912
