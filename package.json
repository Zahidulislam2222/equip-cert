{
  "name": "equip-cert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:config && npm run test:schema && next build",
    "start": "next start",
    "lint": "eslint src/ api/ deploy/ --max-warnings 20",
    "test:config": "node scripts/check-config-boundary.mjs",
    "test:model": "python tests/glb_structure_test.py",
    "test": "npm run test:config && npm run test:schema && npm run test:unit",
    "export:model": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" -b --factory-startup --python scripts/blender/extinguisher.py -- --mode glb --out public/media/extinguisher.glb",
    "build:probe": "esbuild tests/model_render_probe.ts --bundle --format=iife --target=es2022 --outfile=out/probe/probe.js --log-level=warning --loader:.json=json",
    "build:server": "esbuild deploy/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=deploy/generated/server.cjs --log-level=warning",
    "deploy:gen": "node scripts/gen-deploy-artifacts.mjs",
    "test:contrast": "python scripts/check-overlay-contrast.py",
    "encode:flight": "python scripts/encode-flight.py",
    "render:flight": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" -b --factory-startup --python scripts/blender/extinguisher.py --",
    "test:sequence": "node tests/hero_sequence_test.mjs",
    "build:probe:motion": "esbuild tests/hero_motion_probe.ts --bundle --format=iife --target=es2022 --outfile=out/probe/motion.js --log-level=warning --loader:.json=json",
    "test:schema": "node scripts/gen-plan-limits-sql.mjs --check",
    "gen:schema": "node scripts/gen-plan-limits-sql.mjs",
    "test:deps": "node scripts/check-live-dependencies.mjs",
    "test:rls": "node --test \"e2e/*.test.mjs\"",
    "gen:types": "npx --silent supabase gen types typescript --linked > src/lib/database.types.ts",
    "test:types": "node scripts/check-generated-types.mjs",
    "test:migrations": "node scripts/check-migrations-applied.mjs",
    "test:advisors": "node scripts/check-supabase-advisors.mjs",
    "test:unit": "node --test \"unit/*.test.mjs\"",
    "test:rls-policies": "node scripts/check-rls-policies.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:auth-config": "node scripts/auth-config.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.3.2",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contentful": "^11.10.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.4",
    "openai": "^6.15.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.186.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "@vercel/node": "^5.5.16",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "supabase": "2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7"
  }
}
