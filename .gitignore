# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === SECRETS — NEVER COMMIT ===
.env*
!.env.example
*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
# .vscode/ is intentionally tracked: shared Explorer/TS settings for the team
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini

# Docs (local only — not for GitHub)
*.docx
*.doc
*.pdf
!EquipCert-Documentation.md
.claude/

# Agent instructions — kept out of the public repo
CLAUDE.md
AGENTS.md

# Private project dossier (Rule 11) — never commit
PROJECT-DOSSIER.md

# Credentials recovery source (Rule 8) — never commit
CREDENTIALS.md

# Defect log (Rule 15) — local engineering record
DEFECT-LOG.md

# Project memory scratch layer (Rule 16) — may hold infra detail
memory/

# Manual/scratch test scripts (Rule 13) — local tooling, never committed
tests/

# Local documentation view (Google Doc mirror + client assets)
my-project-view/

# Deployment build artifacts (regenerated by `npm run build:server` / `npm run deploy:gen`)
deploy/generated/

# Supabase CLI scratch state (regenerated)
supabase/.temp/

# Exported data from the retired Singapore project — contains personal data (Rule 8/11)
_archive-*/

# ---------------------------------------------------------------------------
# Flutter client (mobile/)
# ---------------------------------------------------------------------------
# Real --dart-define values. The committed sibling is dart_define.example.json,
# which holds names and placeholders only (Rule 12).
mobile/dart_define.json
# Android release signing. key.properties holds the keystore password; the .jks
# holds the private key that IS the app's identity on Play. Losing it means no
# further update to an installed app can ever be signed (Rule 8: values go to
# CREDENTIALS.md, key file stays local).
mobile/android/key.properties
*.jks
*.keystore
# Flutter/Dart build state
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/ephemeral/
mobile/android/.gradle/
mobile/android/local.properties
